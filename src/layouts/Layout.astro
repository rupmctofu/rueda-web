---
import "@/assets/fonts/clash-display.css";

interface Props {
  title?: string;
  description?: string;
}

const SITE_URL = "https://www.espailakalmashamanic.com";
const SITE_NAME = "Rueda Chamánica";

const DEFAULT_TITLE = "Rueda Chamánica · Formación chamánica y maestría";
const DEFAULT_DESCRIPTION =
  "Formación chamánica y maestría de la Rueda de las Cuatro Direcciones con Lidia Hidalgo. Retiros, temazcal y ceremonias andinas en Salomó, Tarragona.";

const { title = DEFAULT_TITLE, description = DEFAULT_DESCRIPTION } =
  Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
const socialImage = new URL("/og-image.jpg", SITE_URL).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "@id": `${SITE_URL}/#organization`,
  name: "Espai La Kalma",
  alternateName: SITE_NAME,
  description,
  url: SITE_URL,
  logo: new URL("/mobile.png", SITE_URL).href,
  image: socialImage,
  telephone: "+34636922215",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Vial Camino, 0",
    addressLocality: "Salomó",
    addressRegion: "Tarragona",
    postalCode: "43812",
    addressCountry: "ES",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 41.265484,
    longitude: 1.358326,
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/jawbreak-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Ilustración de montañas al amanecer, imagen de Rueda Chamánica"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-full focus:bg-teal-950 focus:px-6 focus:py-2 focus:text-gray-50"
    >
      Saltar al contenido
    </a>
    <div class="flex flex-col w-full overflow-x-hidden">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    scroll-behavior: smooth;
    text-wrap: balance;
  }

  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  @font-face {
    font-family: "Jawbreak Sans";
    font-display: swap;
    src: url("/fonts/jawbreak-sans.woff2") format("woff2");
  }
</style>
