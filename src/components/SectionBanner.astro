---
interface Props {
  /** Tailwind background utility, e.g. "bg-norte-image" or "bg-[url('/x.jpg')]". */
  image: string;
  /** Desktop aspect ratio class. Defaults to the one used by the direction sections. */
  aspect?: string;
}

const { image, aspect = "lg:aspect-[10/3]" } = Astro.props;
---

<div
  class:list={[
    "w-full flex aspect-[4/2] bg-no-repeat bg-cover bg-center lg:bg-fixed",
    aspect,
    image,
  ]}
/>
